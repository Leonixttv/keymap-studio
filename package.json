{
  "name": "keymap-studio",
  "version": "0.5.2",
  "private": true,
  "description": "Configuratore USB per tastiere custom",
  "author": "Keymap Studio contributors",
  "license": "GPL-2.0-or-later",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File Build-Portable.ps1"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.keymapstudio.configurator",
    "productName": "Keymap Studio",
    "artifactName": "Keymap-Studio-Portable.exe",
    "files": ["main.cjs", "preload.cjs", "index.html", "layout.js", "app.js", "physical-selection.js", "usb.js", "rgb-preview.js", "advanced.js", "device-backup.js", "matrix.js", "style.css", "icon.ico", "vendor/**", "COPYING"],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": "portable"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
